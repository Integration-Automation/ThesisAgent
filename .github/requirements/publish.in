# The publish-pypi job of release.yml holds the PyPI token. It builds and uploads with the two
# tools below, and builds with the build backend listed after them.
# publish.txt is generated from this file:
# uv pip compile .github/requirements/publish.in --generate-hashes --python-version 3.12 --python-platform x86_64-manylinux_2_28 --only-binary :all: --exclude-newer <7 days ago> -o .github/requirements/publish.txt
# (--python-version is the one the job sets up, the platform is its ubuntu runner. --exclude-newer
# keeps the 7-day wait Dependabot uses: nothing uploaded in the last week.)
build
twine
# The build backend: every package named in [build-system] requires of pyproject.toml. The job
# runs `python -m build --no-isolation`, so the backend is the one locked here and not whatever
# is newest on PyPI when the job runs. --no-isolation checks those requirements instead of
# installing them, so each locked version has to satisfy the floor written in pyproject.toml.
setuptools
wheel
